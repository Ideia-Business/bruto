# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Bruto — dados em runtime ficam em ~/.bruto (fora do repo)
/drizzle/meta/_journal.json.bak
node_modules/
.aiox/
.aiox-core/
.antigravity/
.gemini/
.kimi/

# Artefatos internos da Ideia Business (IdeiaOS) — nunca vão para o repo público.
# Sem estas linhas, uma propagação do kernel ou um `git add -A` distraído
# reintroduz doutrina interna no histórico. Ver CONTRIBUTING.md.
/.claude/
/.cursor/
/.codex/
/.planning/
/.security/
/.aiox-core/
/.aiox/
.aiox-ai-config.yaml
AGENTS.md
CLAUDE.md
IDEIAOS.md
STATE.md
/docs/ideiaos/
/docs/CONTINUATION_HANDOFF.md

# Dados locais / segredos
.env
.env.*
!.env.example

# Dados locais de desenvolvimento (BRUTO_DATA_ROOT apontado para dentro do repo)
/.devdata/

# Build da extensão (gerado por npm run build:ext)
/extension/dist/
